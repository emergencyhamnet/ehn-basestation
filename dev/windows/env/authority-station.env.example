# Authority (main directory) station profile.
# Copy to authority-station.env and set absolute paths. The authority console owns the main DB;
# it does not run gateways.

EHN_BASESTATION_STATION_NAME=authority-station
EHN_BASESTATION_STATION_ROLE=authority

BASESTATION_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\authority\directory\ehn-authority.db
EHN_BASESTATION_AUTHORITY_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\authority\directory\ehn-authority.db
EHN_BASESTATION_PEER_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\stations\local\directory\ehn-directory.db
EHN_BASESTATION_REPLICATION_ROOT=C:\ehn\ehn-basestation\var\replication\bundles
EHN_BASESTATION_LOG_ROOT=C:\ehn\ehn-basestation\var\authority\logs

# Station-link listener for peer replication experiments.
EHN_BASESTATION_LINK_BIND_HOST=127.0.0.1
EHN_BASESTATION_LINK_PORT=7464
EHN_BASESTATION_PEER_HOST=127.0.0.1
EHN_BASESTATION_PEER_PORT=7462

BASESTATION_MESHCORE_ENABLED=0
BASESTATION_SMS_ENABLED=0
EHN_BASESTATION_MAINTENANCE_INTERVAL_SECONDS=0
