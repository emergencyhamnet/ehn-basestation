# Field (local) basestation station profile.
# Copy to local-station.env, then set absolute paths and the live gateway address for your host.

EHN_BASESTATION_STATION_NAME=local-station
EHN_BASESTATION_STATION_ROLE=field
# EHN_BASESTATION_STATION_ID=local-station

# Absolute paths. Default layout is <repo>/var/... when unset.
BASESTATION_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\stations\local\directory\ehn-directory.db
EHN_BASESTATION_AUTHORITY_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\authority\directory\ehn-authority.db
EHN_BASESTATION_PEER_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\stations\peer\directory\ehn-directory.db
EHN_BASESTATION_REPLICATION_ROOT=C:\ehn\ehn-basestation\var\replication\bundles
EHN_BASESTATION_LOG_ROOT=C:\ehn\ehn-basestation\var\stations\local\logs

# MeshCore gateway (Pi running meshcore-pi-port). 7463 is the basestation-facing gateway link.
BASESTATION_MESHCORE_ENABLED=1
BASESTATION_MESHCORE_TRANSPORT=meshcore-runtime
BASESTATION_MESHCORE_LINK_CARRIER=tcp
BASESTATION_MESHCORE_LINK_ENDPOINT=192.168.1.50:7463
BASESTATION_MESHCORE_BASE_URL=http://192.168.1.50:8099
BASESTATION_MESHCORE_CONTRACT_VERSION=1.0

# Optional Meshtastic node on USB serial; install with bootstrap-windows.ps1 -WithMeshtastic.
BASESTATION_MESHTASTIC_ENABLED=0
BASESTATION_MESHTASTIC_GATEWAY_ID=meshtastic-office
BASESTATION_MESHTASTIC_DISPLAY_NAME=Office Meshtastic
BASESTATION_MESHTASTIC_SERIAL_PORT=COM8
BASESTATION_MESHTASTIC_GROUP_CHANNEL_INDEX=1

# SMS gateway (Android app). The gateway id remains EHN-XXX; users type & locally or &XXX by name.
BASESTATION_SMS_ENABLED=1
BASESTATION_SMS_GATEWAY_ID=EHN-XXX
BASESTATION_SMS_DISPLAY_NAME=Android SMS Gateway
# Shared secret the Android app sends as a bearer token. Generate your own.
BASESTATION_SMS_ANDROID_AUTH_TOKEN=change-me

# Delivery maintenance tick (expiry, stale claims, presence sweep, redispatch). 0 disables.
EHN_BASESTATION_MAINTENANCE_INTERVAL_SECONDS=60
