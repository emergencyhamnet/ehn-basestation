# Second field station profile: a separate basestation instance pointed at a second MeshCore gateway
# (for example the new Pi 4 node). Copy to field2-station.env. Uses its own DBs and its own ports so it
# can run beside local-station.env on the same Windows host, or alone on a second machine.
#
# Start with:
#   python -m ehn_basestation.app.cli --env-file dev\windows\env\field2-station.env run-workbench-preview --host 0.0.0.0 --port 18099

EHN_BASESTATION_STATION_NAME=field2-station
EHN_BASESTATION_STATION_ID=field2-station
EHN_BASESTATION_STATION_ROLE=field

BASESTATION_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\stations\field2\directory\ehn-directory.db
# Share the same authority DB as the first station so both hydrate from one main directory.
EHN_BASESTATION_AUTHORITY_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\authority\directory\ehn-authority.db
EHN_BASESTATION_PEER_DIRECTORY_DB_PATH=C:\ehn\ehn-basestation\var\stations\local\directory\ehn-directory.db
EHN_BASESTATION_REPLICATION_ROOT=C:\ehn\ehn-basestation\var\replication\bundles
EHN_BASESTATION_LOG_ROOT=C:\ehn\ehn-basestation\var\stations\field2\logs
EHN_BASESTATION_REGISTRY_DB_PATH=C:\ehn\ehn-basestation\var\stations\field2\registry\ehn-stations.db
EHN_BASESTATION_DELIVERY_DB_PATH=C:\ehn\ehn-basestation\var\stations\field2\delivery\ehn-delivery.db

# Station-link ports distinct from local-station (7462) and authority (7464).
EHN_BASESTATION_LINK_BIND_HOST=127.0.0.1
EHN_BASESTATION_LINK_PORT=7466
EHN_BASESTATION_PEER_HOST=127.0.0.1
EHN_BASESTATION_PEER_PORT=7462

# The second Pi node.
BASESTATION_MESHCORE_ENABLED=1
BASESTATION_MESHCORE_GATEWAY_ID=meshcore-gateway-2
BASESTATION_MESHCORE_DISPLAY_NAME=MeshCore Gateway 2
BASESTATION_MESHCORE_TRANSPORT=meshcore-runtime
BASESTATION_MESHCORE_LINK_CARRIER=tcp
BASESTATION_MESHCORE_LINK_ENDPOINT=192.168.1.60:7463
BASESTATION_MESHCORE_BASE_URL=http://192.168.1.60:8099
BASESTATION_MESHCORE_CONTRACT_VERSION=1.0

# One phone can only poll one workbench; leave SMS off here unless this station has its own phone.
BASESTATION_SMS_ENABLED=0
BASESTATION_SMS_GATEWAY_ID=EHN-XXX-2
BASESTATION_SMS_DISPLAY_NAME=Android SMS Gateway 2
BASESTATION_SMS_ANDROID_AUTH_TOKEN=change-me-2

EHN_BASESTATION_MAINTENANCE_INTERVAL_SECONDS=60
